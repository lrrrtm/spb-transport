# Copy to .env before running Docker Compose. Every value is explicit on purpose.
# Keep empty normally. Temporary local workaround: pypi.org files.pythonhosted.org
UV_INSECURE_HOST=
KAFKA_IMAGE=apache/kafka:4.1.2
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_PORT=9092
KAFKA_MESSAGE_MAX_BYTES=10485760

HADOOP_IMAGE=apache/hadoop:3.4.2
HDFS_NAMENODE_RPC_PORT=9000
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_DATANODE_HTTP_PORT=9864

SPARK_IMAGE=spb-transport-spark:local
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEB_PORT=18080
SPARK_WORKER_WEB_PORT=18081
SPARK_WORKER_CORES=3
SPARK_WORKER_MEMORY=3g
SPARK_EXECUTOR_CORES=1
SPARK_MAX_CORES_PER_JOB=1
SPARK_SHUFFLE_PARTITIONS=12
SPARK_KAFKA_STARTING_OFFSETS=earliest
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_POSITION_WATERMARK=10 minutes
SPARK_POSITION_MAX_SOURCE_AGE_SECONDS=300
SPARK_POSITION_MAX_FUTURE_SKEW_SECONDS=30
SPARK_ETA_WATERMARK=1 hour

HDFS_RAW_REALTIME_PATH=hdfs://hdfs-namenode:9000/raw/realtime
HDFS_RAW_QUARANTINE_PATH=hdfs://hdfs-namenode:9000/quarantine/realtime
HDFS_RAW_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/checkpoints/raw-response-archive
HDFS_POSITION_PROCESSED_PATH=hdfs://hdfs-namenode:9000/processed/vehicle_positions
HDFS_POSITION_QUARANTINE_PATH=hdfs://hdfs-namenode:9000/quarantine/vehicle_positions
HDFS_POSITION_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/checkpoints/vehicle-position-stream
HDFS_ETA_HISTORY_PATH=hdfs://hdfs-namenode:9000/processed/vehicle_eta_history
HDFS_ETA_QUARANTINE_PATH=hdfs://hdfs-namenode:9000/quarantine/vehicle_eta
HDFS_ETA_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/checkpoints/vehicle-eta-stream
HDFS_STATIC_RAW_PATH=hdfs://hdfs-namenode:9000/raw/static_gtfs
HDFS_STATIC_PROCESSED_PATH=hdfs://hdfs-namenode:9000/processed/static_gtfs
HDFS_STATIC_STAGING_PATH=hdfs://hdfs-namenode:9000/staging/static_gtfs

CASSANDRA_IMAGE=cassandra:5.0.5
CASSANDRA_PORT=9042
CASSANDRA_NATIVE_PORT=9042
CASSANDRA_CLUSTER_NAME=spb-transport-local
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_HOST=cassandra
CASSANDRA_KEYSPACE=spb_transport
CASSANDRA_REPLICATION_FACTOR=1
CASSANDRA_LATEST_TTL_SECONDS=120
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_HEAP_NEWSIZE=128M
CASSANDRA_MAX_HEAP_SIZE=512M

# Application settings are consumed when T01+ services are implemented.
GTFS_STATIC_URL=https://transport.orgp.spb.ru/Portal/transport/internalapi/gtfs/feed.zip
GTFS_STATIC_TIMEOUT_SECONDS=120
GTFS_STATIC_RETRY_MAX_ATTEMPTS=4
GTFS_STATIC_RETRY_BACKOFF_SECONDS=1
GTFS_STATIC_MAX_DOWNLOAD_BYTES=536870912
GTFS_STATIC_MAX_UNCOMPRESSED_BYTES=2147483648
GTFS_REALTIME_BASE_URL=https://transport.orgp.spb.ru/Portal/transport/internalapi/gtfs/realtime
GTFS_TLS_VERIFY=true
# GTFS_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
GTFS_CONNECT_TIMEOUT_SECONDS=5
GTFS_READ_TIMEOUT_SECONDS=20
GTFS_WRITE_TIMEOUT_SECONDS=5
GTFS_POOL_TIMEOUT_SECONDS=5
GTFS_RETRY_MAX_ATTEMPTS=4
GTFS_RETRY_BACKOFF_BASE_SECONDS=0.5
GTFS_RETRY_BACKOFF_MAX_SECONDS=8
GTFS_RETRY_JITTER_SECONDS=0.25
GTFS_VEHICLE_POLL_INTERVAL_SECONDS=10
GTFS_VEHICLE_TRIPS_POLL_INTERVAL_SECONDS=30
GTFS_VEHICLE_TRIPS_BATCH_SIZE=100

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_VEHICLE_POSITION_TOPIC=vehicle-position.v1
KAFKA_VEHICLE_POSITION_PARTITIONS=3
KAFKA_VEHICLE_ETA_TOPIC=vehicle-eta.v1
KAFKA_VEHICLE_ETA_PARTITIONS=3
KAFKA_RAW_RESPONSE_TOPIC=gtfs-raw-response.v1
KAFKA_RAW_RESPONSE_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_CLIENT_ID=spb-transport-collector
KAFKA_LINGER_MS=5
KAFKA_MAX_BATCH_SIZE_BYTES=16384
KAFKA_MAX_REQUEST_SIZE_BYTES=10485760
KAFKA_REQUEST_TIMEOUT_MS=30000
