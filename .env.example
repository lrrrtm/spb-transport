# Copy to .env before running Docker Compose. Every value is explicit on purpose.
# Keep empty normally. Temporary local workaround: pypi.org files.pythonhosted.org
UV_INSECURE_HOST=
# Keep true normally. Temporary local workaround for npm behind an untrusted local proxy: false
NPM_CONFIG_STRICT_SSL=true
KAFKA_IMAGE=apache/kafka:4.1.2
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_PORT=9092
KAFKA_MESSAGE_MAX_BYTES=10485760
# Kafka only delivers events; HDFS keeps the long-term history. Old data is deleted by whole
# segments, so segments must roll well within the retention period.
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_SEGMENT_BYTES=104857600
KAFKA_LOG_ROLL_HOURS=1

HADOOP_IMAGE=apache/hadoop:3.4.2
HDFS_NAMENODE_RPC_PORT=9000
HDFS_NAMENODE_HTTP_PORT=9870
HDFS_DATANODE_HTTP_PORT=9864

SPARK_IMAGE=spb-transport-spark:local
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEB_PORT=18080
SPARK_WORKER_WEB_PORT=18081
SPARK_WORKER_CORES=3
SPARK_WORKER_MEMORY=3g
SPARK_EXECUTOR_CORES=1
SPARK_MAX_CORES_PER_JOB=1
SPARK_SHUFFLE_PARTITIONS=12
SPARK_KAFKA_STARTING_OFFSETS=earliest
# Local Kafka retention is short: after downtime longer than it, skip deleted offsets instead of
# crash-looping, and catch up in bounded micro-batches.
SPARK_KAFKA_FAIL_ON_DATA_LOSS=false
SPARK_KAFKA_MAX_OFFSETS_PER_TRIGGER=200000
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_POSITION_WATERMARK=10 minutes
SPARK_POSITION_MAX_SOURCE_AGE_SECONDS=300
SPARK_POSITION_MAX_FUTURE_SKEW_SECONDS=30
SPARK_ETA_WATERMARK=1 hour

HDFS_RAW_REALTIME_PATH=hdfs://hdfs-namenode:9000/raw/realtime
HDFS_RAW_QUARANTINE_PATH=hdfs://hdfs-namenode:9000/quarantine/realtime
HDFS_RAW_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/checkpoints/raw-response-archive
HDFS_POSITION_PROCESSED_PATH=hdfs://hdfs-namenode:9000/processed/vehicle_positions
HDFS_POSITION_QUARANTINE_PATH=hdfs://hdfs-namenode:9000/quarantine/vehicle_positions
HDFS_POSITION_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/checkpoints/vehicle-position-stream
HDFS_ETA_HISTORY_PATH=hdfs://hdfs-namenode:9000/processed/vehicle_eta_history
HDFS_ETA_QUARANTINE_PATH=hdfs://hdfs-namenode:9000/quarantine/vehicle_eta
HDFS_ETA_CHECKPOINT_PATH=hdfs://hdfs-namenode:9000/checkpoints/vehicle-eta-stream
HDFS_STATIC_RAW_PATH=hdfs://hdfs-namenode:9000/raw/static_gtfs
HDFS_STATIC_PROCESSED_PATH=hdfs://hdfs-namenode:9000/processed/static_gtfs
HDFS_STATIC_STAGING_PATH=hdfs://hdfs-namenode:9000/staging/static_gtfs
HDFS_ROUTE_MATCHES_PATH=hdfs://hdfs-namenode:9000/silver/vehicle_route_matches
HDFS_STOP_PATTERNS_PATH=hdfs://hdfs-namenode:9000/silver/shape_stop_patterns
HDFS_STOP_ARRIVALS_PATH=hdfs://hdfs-namenode:9000/silver/stop_arrival_events
HDFS_SEGMENT_TRAVERSALS_PATH=hdfs://hdfs-namenode:9000/silver/segment_traversals
HDFS_SEGMENT_METRICS_PATH=hdfs://hdfs-namenode:9000/gold/segment_metrics
HDFS_TRANSPORT_ANOMALIES_PATH=hdfs://hdfs-namenode:9000/gold/transport_anomalies
HDFS_ETA_COMPARISON_PATH=hdfs://hdfs-namenode:9000/gold/eta_comparison
HDFS_SLOWDOWN_CLASSIFIER_PATH=hdfs://hdfs-namenode:9000/gold/slowdown_classifier
HDFS_ROUTE_CLUSTERS_PATH=hdfs://hdfs-namenode:9000/gold/route_clusters

# T09 route/shape matching, calibrated on the 2026-10-03 midday sample
# (docs/research/route-matching.md).
ROUTE_MATCH_MAX_OFFSET_M=75
ROUTE_MATCH_GPS_SIGMA_M=15
ROUTE_MATCH_OUTLIER_OFFSET_M=50
ROUTE_MATCH_BEARING_WEIGHT=2
ROUTE_MATCH_BEARING_MIN_SPEED=1
ROUTE_MATCH_MAX_BACKTRACK_M=100
ROUTE_MATCH_MAX_SPEED_MPS=30
ROUTE_MATCH_TRANSITION_BETA_M=20
ROUTE_MATCH_SWITCH_COST=12
ROUTE_MATCH_TERMINAL_RESTART_COST=2
ROUTE_MATCH_OFF_ROUTE_TRANSITION_COST=3
ROUTE_MATCH_TERMINAL_ZONE_M=300
ROUTE_MATCH_MAX_GAP_SECONDS=300
ROUTE_MATCH_MIN_CONFIDENCE=0.8

# T10 stop arrivals and segment traversals, calibrated on the 2026-10-03 sample
# (docs/research/stop-arrivals.md).
STOP_EVENT_STOP_MAX_OFFSET_M=40
STOP_EVENT_ZONE_BEFORE_M=40
STOP_EVENT_ZONE_AFTER_M=40
STOP_EVENT_MAX_INTERPOLATION_GAP_SECONDS=120
STOP_EVENT_STOPPED_MAX_SPEED_MPS=0.5

# T13 segment bottleneck metrics. A traversal contributes to statistics only when all three
# quality thresholds pass; coverage still includes rejected traversals in its denominator.
SEGMENT_METRICS_MIN_OBSERVATIONS=3
SEGMENT_METRICS_MAX_GAP_SECONDS=60
SEGMENT_METRICS_MIN_CONFIDENCE=0.8
SEGMENT_METRICS_MIN_SAMPLES=10

# T14 transport anomalies. Initial conservative thresholds for the demo dataset.
ANOMALY_BUNCHING_DISTANCE_M=300
ANOMALY_SNAPSHOT_SECONDS=30
ANOMALY_SHORT_HEADWAY_SECONDS=120
ANOMALY_LONG_HEADWAY_SECONDS=1800
ANOMALY_STATIONARY_SPEED_MPS=0.5
ANOMALY_STATIONARY_PROGRESS_M=10
ANOMALY_STATIONARY_DURATION_SECONDS=300
ANOMALY_MAX_OBSERVATION_GAP_SECONDS=60
ANOMALY_DISAPPEARANCE_SECONDS=300
ANOMALY_TERMINAL_ZONE_M=300
ANOMALY_GPS_JUMP_SPEED_MPS=50
ANOMALY_SHAPE_OFFSET_M=100

# T15 ETA baseline and offline evaluation.
ETA_BASELINE_MAX_CURRENT_STOP_AGE_SECONDS=600
ETA_BASELINE_MAX_HORIZON_SECONDS=3600
ETA_BASELINE_MIN_SEGMENT_SAMPLES=5

# T16 next-segment slowdown classification baseline.
SLOWDOWN_MIN_BASELINE_SAMPLES=10
SLOWDOWN_CLASSIFIER_RISK_THRESHOLD=1.1

# T17 route feature engineering and clustering.
ROUTE_CLUSTER_COUNT=4
ROUTE_CLUSTER_MAX_ITERATIONS=50
ROUTE_CLUSTER_MIN_QUALIFIED_SAMPLES=100

CASSANDRA_IMAGE=cassandra:5.0.5
CASSANDRA_PORT=9042
CASSANDRA_NATIVE_PORT=9042
CASSANDRA_CLUSTER_NAME=spb-transport-local
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_HOST=cassandra
CASSANDRA_KEYSPACE=spb_transport
CASSANDRA_REPLICATION_FACTOR=1
CASSANDRA_LATEST_TTL_SECONDS=120
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_HEAP_NEWSIZE=128M
CASSANDRA_MAX_HEAP_SIZE=512M

# T11 FastAPI
API_EXTERNAL_PORT=8000
API_CASSANDRA_REQUEST_TIMEOUT_SECONDS=5
API_VEHICLE_FRESHNESS_SECONDS=120
API_DEFAULT_PAGE_SIZE=100
API_MAX_PAGE_SIZE=500
API_HISTORY_MAX_RANGE_HOURS=24
API_HISTORY_DEFAULT_RANGE_MINUTES=60
API_CORS_ORIGINS=http://localhost:5173

# T12 web
WEB_EXTERNAL_PORT=5173

# Application settings are consumed when T01+ services are implemented.
GTFS_STATIC_URL=https://transport.orgp.spb.ru/Portal/transport/internalapi/gtfs/feed.zip
GTFS_STATIC_TIMEOUT_SECONDS=120
GTFS_STATIC_RETRY_MAX_ATTEMPTS=4
GTFS_STATIC_RETRY_BACKOFF_SECONDS=1
GTFS_STATIC_MAX_DOWNLOAD_BYTES=536870912
GTFS_STATIC_MAX_UNCOMPRESSED_BYTES=2147483648
GTFS_REALTIME_BASE_URL=https://transport.orgp.spb.ru/Portal/transport/internalapi/gtfs/realtime
GTFS_TLS_VERIFY=true
# GTFS_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
GTFS_CONNECT_TIMEOUT_SECONDS=5
GTFS_READ_TIMEOUT_SECONDS=20
GTFS_WRITE_TIMEOUT_SECONDS=5
GTFS_POOL_TIMEOUT_SECONDS=5
GTFS_RETRY_MAX_ATTEMPTS=4
GTFS_RETRY_BACKOFF_BASE_SECONDS=0.5
GTFS_RETRY_BACKOFF_MAX_SECONDS=8
GTFS_RETRY_JITTER_SECONDS=0.25
GTFS_VEHICLE_POLL_INTERVAL_SECONDS=10
GTFS_VEHICLE_TRIPS_POLL_INTERVAL_SECONDS=30
GTFS_VEHICLE_TRIPS_BATCH_SIZE=100

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_VEHICLE_POSITION_TOPIC=vehicle-position.v1
KAFKA_VEHICLE_POSITION_PARTITIONS=3
KAFKA_VEHICLE_ETA_TOPIC=vehicle-eta.v1
KAFKA_VEHICLE_ETA_PARTITIONS=3
KAFKA_RAW_RESPONSE_TOPIC=gtfs-raw-response.v1
KAFKA_RAW_RESPONSE_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_CLIENT_ID=spb-transport-collector
KAFKA_LINGER_MS=5
KAFKA_MAX_BATCH_SIZE_BYTES=16384
KAFKA_MAX_REQUEST_SIZE_BYTES=10485760
KAFKA_REQUEST_TIMEOUT_MS=30000
