CREATE KEYSPACE IF NOT EXISTS {{KEYSPACE}}
WITH replication = {
  'class': 'NetworkTopologyStrategy',
  '{{DATACENTER}}': {{REPLICATION_FACTOR}}
};

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.vehicle_latest_by_vehicle (
  vehicle_id text PRIMARY KEY,
  route_id text,
  event_id text,
  source_timestamp timestamp,
  collected_at timestamp,
  latitude double,
  longitude double,
  bearing double,
  speed double,
  label text,
  license_plate text,
  quality_flags list<text>,
  has_quality_flags boolean
);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.vehicles_latest_by_route (
  route_id text,
  vehicle_id text,
  event_id text,
  source_timestamp timestamp,
  collected_at timestamp,
  latitude double,
  longitude double,
  bearing double,
  speed double,
  label text,
  license_plate text,
  quality_flags list<text>,
  has_quality_flags boolean,
  PRIMARY KEY ((route_id), vehicle_id)
);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.vehicle_positions_by_vehicle_day (
  vehicle_id text,
  event_date date,
  source_timestamp timestamp,
  event_id text,
  route_id text,
  collected_at timestamp,
  latitude double,
  longitude double,
  bearing double,
  speed double,
  label text,
  license_plate text,
  quality_flags list<text>,
  has_quality_flags boolean,
  PRIMARY KEY ((vehicle_id, event_date), source_timestamp, event_id)
) WITH CLUSTERING ORDER BY (source_timestamp DESC, event_id ASC);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.eta_history_by_vehicle_day (
  vehicle_id text,
  collected_date date,
  collected_at timestamp,
  event_id text,
  route_id text,
  forecast_count int,
  eta_status text,
  forecasts_json text,
  PRIMARY KEY ((vehicle_id, collected_date), collected_at, event_id)
) WITH CLUSTERING ORDER BY (collected_at DESC, event_id ASC);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.static_feed_current (
  feed text PRIMARY KEY,
  static_feed_version text,
  published_at timestamp
);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.routes_by_feed (
  static_feed_version text,
  route_id text,
  agency_id text,
  route_short_name text,
  route_long_name text,
  route_type int,
  PRIMARY KEY ((static_feed_version), route_id)
);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.stops_by_route (
  static_feed_version text,
  route_id text,
  shape_id text,
  stop_index int,
  direction_id int,
  pattern_id text,
  stop_id text,
  stop_code text,
  stop_name text,
  stop_lat double,
  stop_lon double,
  distance_along_m double,
  PRIMARY KEY ((static_feed_version, route_id), shape_id, stop_index)
);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.segment_metrics_by_route_bucket (
  static_feed_version text,
  route_id text,
  analysis_start date,
  analysis_end date,
  day_type text,
  hour int,
  shape_id text,
  direction_id int,
  pattern_id text,
  from_stop_id text,
  to_stop_id text,
  from_stop_index int,
  to_stop_index int,
  segment_length_m double,
  total_samples bigint,
  qualified_samples bigint,
  vehicle_count bigint,
  service_day_count bigint,
  coverage double,
  travel_time_p25_s double,
  travel_time_p50_s double,
  travel_time_p75_s double,
  travel_time_p90_s double,
  travel_time_p95_s double,
  travel_time_iqr_s double,
  travel_time_mad_s double,
  speed_p50_mps double,
  stop_delay_share double,
  peak_offpeak_ratio double,
  enough_data boolean,
  algorithm_version text,
  PRIMARY KEY ((algorithm_version, static_feed_version, route_id, analysis_start, analysis_end, day_type, hour), direction_id, shape_id, from_stop_index)
);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.anomalies_by_route_day (
  algorithm_version text,
  event_date date,
  route_id text,
  started_at timestamp,
  anomaly_id text,
  anomaly_type text,
  static_feed_version text,
  shape_id text,
  direction_id int,
  vehicle_id text,
  related_vehicle_id text,
  stop_id text,
  ended_at timestamp,
  duration_s double,
  distance_gap_m double,
  headway_s double,
  latitude double,
  longitude double,
  PRIMARY KEY ((algorithm_version, route_id, event_date), started_at, anomaly_id)
) WITH CLUSTERING ORDER BY (started_at DESC, anomaly_id ASC);

CREATE TABLE IF NOT EXISTS {{KEYSPACE}}.eta_comparison_by_route_day (
  algorithm_version text,
  evaluation_date date,
  training_start date,
  training_end date,
  route_id text,
  horizon_bucket text,
  labeled_forecasts bigint,
  paired_forecasts bigint,
  baseline_coverage double,
  official_mae_s double,
  official_median_absolute_error_s double,
  baseline_mae_s double,
  baseline_median_absolute_error_s double,
  PRIMARY KEY ((algorithm_version, evaluation_date, training_start, training_end, route_id), horizon_bucket)
);
